{
  "format_version": "1.8.0",
  "animations": {
    "animation.rp02.chunk_visualizer": {
      "loop": true,
      "bones": {
        "viz_world_aligned_root": {
          "rotation": [
            0.0,
            "-q.body_y_rotation",
            0.0
          ],
          "scale": "v.rp02_mode >= 1 ? 1.0 : 0.0"
        },
        "chunk_cage_group": {
          "position": [
            "-(q.position(0) - math.floor(q.position(0) / 16.0) * 16.0) * 16.0",
            0.0,
            "(q.position(2) - math.floor(q.position(2) / 16.0) * 16.0) * 16.0"
          ],
          "scale": "v.rp02_mode >= 1 ? 1.0 : 0.0"
        },
        "subchunk_rings": {
          "position": [
            0.0,
            "-(q.position(1) - math.floor(q.position(1) / 16.0) * 16.0) * 16.0",
            0.0
          ]
        },
        "player_spawn_sphere_group": {
          "position": [
            "-(q.position(0) - (math.floor(q.position(0)) + 0.5)) * 16.0",
            "-(q.position(1) - math.floor(q.position(1))) * 16.0",
            "(q.position(2) - (math.floor(q.position(2)) + 0.5)) * 16.0"
          ],
          "scale": "v.rp02_mode == 2 ? 1.0 : 0.0"
        },
        "floor_zones_group": {
          "scale": "v.rp02_mode == 2 ? 1.0 : 0.0"
        },
        "sphere_24_safe": {
          "scale": "v.rp02_mode == 2 ? 1.0 : 0.0"
        },
        "sphere_44_spawn_upper": {
          "scale": "v.rp02_mode == 2 ? 1.0 : 0.0"
        },
        "sphere_44_spawn_lower": {
          "scale": "v.rp02_mode == 2 ? 1.0 : 0.0"
        },
        "globe_spin_24_a": {
          "rotation": [
            0.0,
            "math.mod(q.life_time * 24.0, 360.0)",
            0.0
          ]
        },
        "globe_spin_24_b": {
          "rotation": [
            0.0,
            "math.mod(q.life_time * 24.0 + 45.0, 360.0)",
            0.0
          ]
        },
        "globe_spin_44_a": {
          "rotation": [
            0.0,
            "math.mod(q.life_time * 16.0, 360.0)",
            0.0
          ]
        },
        "globe_spin_44_b": {
          "rotation": [
            0.0,
            "math.mod(q.life_time * 16.0 + 45.0, 360.0)",
            0.0
          ]
        },
        "mode_label_bone": {
          "rotation": [
            "-q.camera_rotation(0) * 0.35",
            "q.camera_rotation(1) - q.body_y_rotation + 180.0",
            0.0
          ],
          "scale": "v.rp02_mode >= 1 ? 1.0 : 0.0"
        },
        "cull_bounds_anchor": {
          "rotation": [
            0.0,
            "-q.body_y_rotation",
            0.0
          ],
          "scale": "v.rp02_mode >= 1 ? 1.0 : 0.0"
        }
      }
    }
  }
}
